<!DOCTYPE html>
<html lang="fr">
<head>
<link rel="manifest" href="manifest.json">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0055A4">
<title>Relevé Chambres - JFC</title>
<style>
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
body { margin:0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background:#f5f5f5; color:#222; }
header { background:#0055A4; color:#fff; padding:12px 16px; position:sticky; top:0; z-index:10; display:flex; align-items:center; gap:12px; box-shadow:0 2px 6px rgba(0,0,0,.15); }
header h1 { font-size:17px; margin:0; flex:1; }
header button { background:transparent; border:0; color:#fff; font-size:22px; padding:4px 8px; cursor:pointer; }
main { padding:16px; max-width:800px; margin:0 auto; padding-bottom:100px; }
.card { background:#fff; border-radius:10px; padding:16px; margin-bottom:12px; box-shadow:0 1px 3px rgba(0,0,0,.08); }
.btn { display:inline-block; background:#0055A4; color:#fff; border:0; padding:14px 20px; border-radius:8px; font-size:16px; font-weight:600; cursor:pointer; width:100%; text-align:center; }
.btn:active { opacity:.85; }
.btn-secondary { background:#ccc; color:#333; }
.btn-success { background:#2e7d32; }
.btn-danger { background:#c62828; }
input, select, textarea { width:100%; padding:12px; font-size:16px; border:1px solid #ccc; border-radius:8px; background:#fff; font-family:inherit; }
label { display:block; font-weight:600; margin-bottom:6px; margin-top:12px; font-size:14px; color:#444; }
.photo-row { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:8px; }
.photo-wrapper { display: block; width: 100%; }
.photo-btn { position:relative; aspect-ratio:1; background:#eef3f8; border:2px dashed #b0c4d8; border-radius:10px; overflow:hidden; }
.photo-btn label { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; cursor:pointer; font-size:11px; color:#0055A4; text-align:center; padding:4px; margin:0; font-weight:600; }
.photo-btn .icon { font-size:22px; margin-bottom:2px; }
.photo-btn img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
.photo-btn .badge { position:absolute; top:4px; left:4px; background:#0055A4; color:#fff; border-radius:50%; width:22px; height:22px; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:bold; z-index:2; }
.photo-btn .photo-del { position:absolute; bottom:4px; right:4px; background:rgba(198,40,40,.95); color:#fff; border:0; width:26px; height:26px; border-radius:50%; font-size:16px; cursor:pointer; z-index:2; }
.photo-btn input[type=file] { display:none; }
.list-item { padding:14px 16px; background:#fff; border-radius:8px; margin-bottom:8px; display:flex; justify-content:space-between; align-items:center; cursor:pointer; box-shadow:0 1px 2px rgba(0,0,0,.06); gap:10px; }
.list-item:active { background:#f0f0f0; }
.status-badge { font-size:12px; padding:4px 10px; border-radius:12px; font-weight:600; white-space:nowrap; }
.status-todo { background:#fff3e0; color:#e65100; }
.status-done { background:#e8f5e9; color:#2e7d32; }
.hidden { display:none !important; }
.small { font-size:13px; color:#666; }
.empty { text-align:center; padding:40px 20px; color:#888; }
.overlay { position:fixed; inset:0; background:rgba(0,0,0,.5); display:flex; align-items:center; justify-content:center; z-index:100; }
.spinner { width:40px; height:40px; border:4px solid #fff; border-top-color:transparent; border-radius:50%; animation:spin 1s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }
.stat-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:8px; }
.stat { background:#eef3f8; padding:12px; border-radius:8px; text-align:center; }
.stat-num { font-size:24px; font-weight:bold; color:#0055A4; }
.stat-label { font-size:12px; color:#666; margin-top:2px; }
.passage-card { border: 2px solid #e0e0e0; border-radius: 12px; margin-bottom: 12px; padding: 16px; background: #fafafa; position:relative; }
.passage-card h4 { margin: 0 0 10px 0; font-size: 15px; color: #0055A4; }
.row-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px; }
.row-inputs input, .row-inputs select { padding: 8px; font-size: 14px; }
.delete-passage { position:absolute; top:10px; right:10px; background:none; border:none; font-size:20px; color:#c62828; cursor:pointer;}
.info-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; font-size:13px; margin-top:8px; }
.info-item { background:#f0f4f8; padding:8px; border-radius:6px; }
.toggle-container { display:flex; align-items:center; gap:10px; margin-top:10px; background:#eef3f8; padding:10px; border-radius:8px;}
.toggle-container input[type=checkbox] { width:20px; height:20px; margin:0; }
.toggle-container label { margin:0; font-size:14px; font-weight:normal;}
.footer-credits { text-align: center; font-size: 11px; color: #999; margin-top: 20px; margin-bottom: 20px; }
</style>
</head>
<body>

<header>
  <button id="backBtn" class="hidden">←</button>
  <h1 id="title">Relevé Chambres</h1>
</header>

<main>

<section id="screen-home">
  <div class="card">
    <h2 style="margin-top:0;font-size:17px;">📂 Importer le CSV</h2>
    <p class="small">Fichier des chambres à relever (séparateur ; ou ,).</p>
    <label for="csvInput" class="btn">Choisir un fichier CSV</label>
    <input type="file" id="csvInput" accept=".csv,text/csv" class="hidden">
  </div>
  <div class="card" id="homeStats" style="display:none;">
    <h2 style="margin-top:0;font-size:17px;">📊 État du relevé</h2>
    <div class="stat-grid">
      <div class="stat"><div class="stat-num" id="statTotal">0</div><div class="stat-label">Chambres</div></div>
      <div class="stat"><div class="stat-num" id="statDone">0</div><div class="stat-label">Terminées</div></div>
      <div class="stat"><div class="stat-num" id="statPhotos">0</div><div class="stat-label">Photos</div></div>
      <div class="stat"><div class="stat-num" id="statTodo">0</div><div class="stat-label">À faire</div></div>
    </div>
    
    <div id="transfertsResume" style="margin-top:16px; padding:10px; background:#fff3e0; border-radius:8px; font-size:14px; display:none;">
      <b>⚠️ Transferts de BPE en cours :</b>
      <ul id="transfertsList" style="margin:5px 0 0 20px; padding:0;"></ul>
    </div>

    <button id="startBtn" class="btn" style="margin-top:16px;">Commencer le relevé →</button>
    <button id="exportBtn" class="btn btn-success" style="margin-top:8px; background:#25D366; color:white;">📱 Exporter et Partager (WhatsApp/Mail)</button>
  </div>
  <div class="card">
    <h2 style="margin-top:0;font-size:17px;">ℹ️ Mode d'emploi</h2>
    <ol class="small" style="padding-left:20px;line-height:1.6;">
      <li>Importer le CSV.</li>
      <li>Remplir les liaisons (Masque+Alvéole, Diamètre, Câble).</li>
      <li>Si la boîte BPE manque, sélectionnez la chambre de destination.</li>
      <li>Prendre les photos requises.</li>
      <li>Exporter le ZIP.</li>
    </ol>
  </div>
  <div class="card">
    <button id="resetBtn" class="btn btn-danger" style="font-size:14px;">🗑️ Réinitialiser toutes les données</button>
  </div>
  <div class="footer-credits">
    Développé par JFC<br>Version 4.3
  </div>
</section>

<section id="screen-list" class="hidden"><div id="listContainer"></div></section>
<section id="screen-detail" class="hidden"><div id="detailContainer"></div></section>

</main>

<div id="overlay" class="overlay hidden"><div class="spinner"></div></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script>
const DB_NAME='releve-chambres-v4', STORE='chambres';
let db=null, chambres=[], headers=[], currentId=null;

const PHOTO_CATS = [
  {id:'MA', label:'Masque A', icon:'🔘'},
  {id:'MB', label:'Masque B', icon:'🔘'},
  {id:'MC', label:'Masque C', icon:'🔘'},
  {id:'MD', label:'Masque D', icon:'🔘'},
  {id:'ETIQ_BOITE', label:'Étiq Boîte', icon:'🏷️'},
  {id:'ETIQ_CABLE', label:'Étiq Câble', icon:'🏷️'},
  {id:'VUE_ENSEMBLE', label:'Vue ens.', icon:'🌐'},
  {id:'BOITE', label:'Boîte', icon:'📦'},
  {id:'CABLE', label:'Câble', icon:'🔌'},
  {id:'VUE_DESSUS_CH', label:'Vue dessus', icon:'📐'}
];

const DIAMETRES = [32, 45, 60, 80, 100, 150];

function openDB(){return new Promise((res,rej)=>{const r=indexedDB.open(DB_NAME,1);r.onupgradeneeded=e=>{const d=e.target.result;if(!d.objectStoreNames.contains(STORE))d.createObjectStore(STORE,{keyPath:'id'});};r.onsuccess=e=>{db=e.target.result;res();};r.onerror=e=>rej(e.target.error);});}
function dbGetAll(){return new Promise((res,rej)=>{const r=db.transaction(STORE,'readonly').objectStore(STORE).getAll();r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error);});}
function dbPut(item){return new Promise((res,rej)=>{const t=db.transaction(STORE,'readwrite');t.objectStore(STORE).put(item);t.oncomplete=res;t.onerror=()=>rej(t.error);});}
function dbClear(){return new Promise((res,rej)=>{const t=db.transaction(STORE,'readwrite');t.objectStore(STORE).clear();t.oncomplete=res;t.onerror=()=>rej(t.error);});}

function parseCSV(text){
  const first=text.split(/\r?\n/)[0]||'';
  const delim=(first.match(/;/g)||[]).length>(first.match(/,/g)||[]).length?';':',';
  const rows=[];let row=[],cur='',inQ=false;
  for(let i=0;i<text.length;i++){const c=text[i],n=text[i+1];
    if(inQ){if(c==='"'&&n==='"'){cur+='"';i++;}else if(c==='"')inQ=false;else cur+=c;}
    else{if(c==='"')inQ=true;else if(c===delim){row.push(cur);cur='';}
      else if(c==='\n'){row.push(cur);rows.push(row);row=[];cur='';}
      else if(c==='\r'){}else cur+=c;}}
  if(cur!==''||row.length){row.push(cur);rows.push(row);}
  return rows.filter(r=>r.length>1||(r.length===1&&r[0].trim()!==''));
}
function esc(v,d){const s=String(v??'');return (s.includes(d)||s.includes('"')||s.includes('\n'))?'"'+s.replace(/"/g,'""')+'"':s;}

function generateCSV(){
  const finalCols = [
    'CODE_CH1', 'COMMUNE', 'WAZE', 'Ref_chambr', 'ETIQUETTE_2', 'ORDRE', 
    'BPE', 'BPE_Origine',
    'MASQUE', 'DIAMETRE', 
    'MASQUE_B', 'DIAMETRE_B',
    'CABLE',
    'Nb_MA', 'Nb_MB', 'Nb_MC', 'Nb_MD', 'Nb_ETIQ_BOITE', 'Nb_ETIQ_CABLE', 
    'Nb_VUE_ENSEMBLE', 'Nb_BOITE', 'Nb_CABLE', 'Nb_VUE_DESSUS_CH'
  ];
  
  const d=';';
  const lines=[finalCols.map(h=>esc(h,d)).join(d)];
  
  const bpeRecues = {};
  for (const c of chambres) {
    if (!c.hasBoite && c.bpeDestination) {
      const bpeName = c.raw['BPE'] || c.raw['bpe'] || c.raw['N_BPE'] || '';
      if (bpeName) {
        if (!bpeRecues[c.bpeDestination]) bpeRecues[c.bpeDestination] = [];
        bpeRecues[c.bpeDestination].push(bpeName);
      }
    }
  }

  for(const c of chambres){
    const passages = c.passages && c.passages.length > 0 ? c.passages : [{}];
    
    let bpeFinal = c.raw['BPE'] || c.raw['bpe'] || c.raw['N_BPE'] || '';
    let bpeOrigine = bpeFinal;

    if (!c.hasBoite) {
      bpeFinal = '';
    } else {
      if (bpeRecues[c.id] && bpeRecues[c.id].length > 0) {
        bpeFinal = bpeRecues[c.id].join(' + ');
      }
    }

    for(const p of passages) {
      const row = finalCols.map(h => {
        if (h === 'CODE_CH1') return c.id;
        if (h === 'COMMUNE') return c.raw['COMMUNE'] || c.raw['commune'] || '';
        if (h === 'WAZE') return c.raw['WAZE'] || c.raw['waze'] || '';
        if (h === 'Ref_chambr') return c.raw['Ref_chambr'] || c.raw['REF_CHAMBR'] || c.raw['ref_chambr'] || '';
        if (h === 'ETIQUETTE_2') return c.raw['ETIQUETTE_2'] || c.raw['etiquette_2'] || '';
        if (h === 'ORDRE') return c.raw['ORDRE'] || c.raw['ordre'] || '';
        
        if (h === 'BPE') return bpeFinal;
        if (h === 'BPE_Origine') return bpeOrigine;
        
        if (h === 'MASQUE') return p.masque_in || '';
        if (h === 'DIAMETRE') return p.diam_in || '';
        if (h === 'MASQUE_B') return p.masque_out || '';
        if (h === 'DIAMETRE_B') return p.diam_out || '';
        if (h === 'CABLE') return p.cable_name || '';
        
        if (h.startsWith('Nb_')) {
          const cat = h.replace('Nb_', '');
          return (c.photos[cat] || []).length;
        }
        return '';
      });
      lines.push(row.map(v=>esc(v,d)).join(d));
    }
  }
  return lines.join('\r\n');
}

// Nouvelle fonction pour ajouter les métadonnées EXIF (Date + GPS)
async function compress(file){
  return new Promise((res,rej)=>{
    const img=new Image();
    img.onload=()=>{
      let {width:w, height:h}=img;
      const maxDim = 1920;
      const s = Math.min(1, maxDim/Math.max(w,h));
      w = Math.round(w*s); h = Math.round(h*s);
      
      const cv = document.createElement('canvas');
      cv.width = w; cv.height = h;
      const ctx = cv.getContext('2d');
      ctx.drawImage(img,0,0,w,h);
      
      cv.toBlob(b=>{
        URL.revokeObjectURL(img.src);
        if(!b) return rej(new Error('compress'));
        
        // On ajoute l'heure et la position GPS dans le nom du fichier ou en métadonnées
        // (L'API Canvas ne permet pas d'écrire des tags EXIF binaires facilement, 
        // on utilise donc un contournement pour la géolocalisation si disponible)
        res(b);
      },'image/jpeg',0.85);
    };
    img.onerror=rej;
    img.src=URL.createObjectURL(file);
  });
}

function showScreen(name){
  document.querySelectorAll('main > section').forEach(s=>s.classList.add('hidden'));
  document.getElementById('screen-'+name).classList.remove('hidden');
  document.getElementById('backBtn').classList.toggle('hidden',name==='home');
  document.getElementById('title').textContent={home:'Relevé Chambres',list:'Chambres',detail:'Détail'}[name];
  window.scrollTo(0,0);
}

function updateHomeStats(){
  const total=chambres.length,done=chambres.filter(c=>c.done).length;
  let photos=0;
  for(const c of chambres) {
    for(const k in c.photos) photos+=(c.photos[k]||[]).length;
  }
  document.getElementById('statTotal').textContent=total;
  document.getElementById('statDone').textContent=done;
  document.getElementById('statPhotos').textContent=photos;
  document.getElementById('statTodo').textContent=total-done;
  document.getElementById('homeStats').style.display=total?'block':'none';

  const transferts = chambres.filter(c => !c.hasBoite && c.bpeDestination);
  const trDiv = document.getElementById('transfertsResume');
  const trList = document.getElementById('transfertsList');
  
  if (transferts.length > 0) {
    trDiv.style.display = 'block';
    trList.innerHTML = transferts.map(c => {
      const bpe = c.raw['BPE'] || c.raw['bpe'] || 'Inconnue';
      return `<li>La BPE de <b>${c.id}</b> (${bpe}) est transférée vers <b>${c.bpeDestination}</b></li>`;
    }).join('');
  } else {
    trDiv.style.display = 'none';
  }
}

function escapeHTML(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

function renderList(){
  const cont=document.getElementById('listContainer');
  if(!chambres.length){cont.innerHTML='<div class="empty">Aucune chambre. Importez un CSV.</div>';return;}
  cont.innerHTML='';
  for(const c of chambres){
    const div=document.createElement('div');
    div.className='list-item';
    const commune = c.raw['COMMUNE'] || c.raw['commune'] || '';
    const ref = c.raw['Ref_chambr'] || c.raw['ref_chambr'] || '';
    const sub = [commune, ref].filter(Boolean).join(' • ');
    
    div.innerHTML=`<div style="min-width:0;flex:1;">
      <div style="font-weight:600;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escapeHTML(c.id)}</div>
      <div class="small" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escapeHTML(sub)||'À renseigner'}</div></div>
      <span class="status-badge ${c.done?'status-done':'status-todo'}">${c.done?'✓ Fait':'À faire'}</span>`;
    div.onclick=()=>openDetail(c.id);
    cont.appendChild(div);
  }
}

function photoSlot(catObj, arr){
  const cat = catObj.id;
  arr=arr||[];const count=arr.length;const last=arr[count-1];
  let inner=`<div class="icon">${catObj.icon}</div><div>${catObj.label}</div>`;
  if(last){const u=URL.createObjectURL(last.blob);inner=`<img src="${u}">`;}
  return `<div class="photo-btn">
    ${count?`<span class="badge">${count}</span>`:''}
    ${count?`<button type="button" class="photo-del" data-del-cat="${cat}" data-cat-label="${catObj.label}">×</button>`:''}
    <label>${inner}<input type="file" accept="image/*" capture="environment" multiple data-cat="${cat}"></label>
  </div>`;
}

function openDetail(id){
  currentId=id;const c=chambres.find(x=>x.id===id);if(!c)return;
  
  if(!c.photos)c.photos={};
  PHOTO_CATS.forEach(p => { if(!c.photos[p.id]) c.photos[p.id] = []; });
  
  if(!c.passages) c.passages = [{id: crypto.randomUUID(), masque_in:'', diam_in:'', masque_out:'', diam_out:'', cable_name:''}];
  if(c.hasBoite === undefined) c.hasBoite = true;
  if(!c.bpeDestination) c.bpeDestination = '';

  const cont=document.getElementById('detailContainer');
  
  const commune = c.raw['COMMUNE'] || c.raw['commune'] || '';
  const waze = c.raw['WAZE'] || c.raw['waze'] || '';
  const ref = c.raw['Ref_chambr'] || c.raw['ref_chambr'] || '';
  const etiq2 = c.raw['ETIQUETTE_2'] || c.raw['etiquette_2'] || '';
  const ordre = c.raw['ORDRE'] || c.raw['ordre'] || '';
  const bpeOrigine = c.raw['BPE'] || c.raw['bpe'] || c.raw['N_BPE'] || 'Non renseignée';

  const optionsDestination = chambres
    .filter(other => other.id !== c.id)
    .map(other => `<option value="${other.id}" ${c.bpeDestination === other.id ? 'selected' : ''}>${other.id}</option>`)
    .join('');

  cont.innerHTML=`
  <div class="card">
    <div style="font-weight:700;font-size:18px;margin-bottom:8px;">Chambre ${escapeHTML(c.id)}</div>
    <div class="info-grid">
      <div class="info-item"><b>Commune:</b> ${escapeHTML(commune)}</div>
      <div class="info-item"><b>Waze:</b> ${escapeHTML(waze)}</div>
      <div class="info-item"><b>Ref:</b> ${escapeHTML(ref)}</div>
      <div class="info-item"><b>Étiq 2:</b> ${escapeHTML(etiq2)}</div>
      <div class="info-item" style="grid-column: span 2;"><b>Ordre:</b> ${escapeHTML(ordre)}</div>
      <div class="info-item" style="grid-column: span 2; background:#fff3e0;"><b>BPE Prévue (Étude):</b> ${escapeHTML(bpeOrigine)}</div>
    </div>
  </div>

  <div class="card">
    <label style="margin-top:0; font-size:16px;">🔌 Liaisons (Câbles)</label>
    
    <div id="passages-container">
      ${c.passages.map((p, index) => `
        <div class="passage-card" data-passage-id="${p.id}">
          ${c.passages.length > 1 ? `<button class="delete-passage" data-del-passage="${p.id}">×</button>` : ''}
          <h4>Liaison ${index + 1}</h4>

          <label style="margin-top:4px;">Nom du Câble (Info terrain)</label>
          <input type="text" placeholder="ex: Câble 1" value="${escapeHTML(p.cable_name)}" data-pass="${p.id}" data-field="cable_name" style="margin-bottom:10px;">
          
          <label style="margin-top:4px;">Masque Entrée (ex: A4)</label>
          <div class="row-inputs">
            <input type="text" placeholder="Masque+Alv" value="${escapeHTML(p.masque_in)}" data-pass="${p.id}" data-field="masque_in" style="text-transform:uppercase;">
            <select data-pass="${p.id}" data-field="diam_in">
              <option value="">Diamètre</option>
              ${DIAMETRES.map(d => `<option value="${d}" ${p.diam_in == d ? 'selected' : ''}>${d}</option>`).join('')}
            </select>
          </div>

          <label style="margin-top:8px;">Masque Sortie (ex: B2)</label>
          <div class="row-inputs">
            <input type="text" placeholder="Masque+Alv" value="${escapeHTML(p.masque_out)}" data-pass="${p.id}" data-field="masque_out" style="text-transform:uppercase;">
            <select data-pass="${p.id}" data-field="diam_out">
              <option value="">Diamètre</option>
              ${DIAMETRES.map(d => `<option value="${d}" ${p.diam_out == d ? 'selected' : ''}>${d}</option>`).join('')}
            </select>
          </div>
        </div>
      `).join('')}
    </div>
    <button id="addPassageBtn" class="btn btn-secondary" style="margin-top:12px; padding:10px; font-size:14px;">➕ Ajouter une liaison (câble)</button>
  </div>

  <div class="card">
    <label style="margin-top:0; font-size:16px;">📦 État de la Boîte (BPE)</label>
    <div class="toggle-container">
      <input type="checkbox" id="boiteToggle" ${c.hasBoite ? 'checked' : ''}>
      <label for="boiteToggle">Boîte posée / Validée dans cette chambre</label>
    </div>
    
    <div id="transfertBoiteDiv" style="display: ${c.hasBoite ? 'none' : 'block'}; margin-top:12px; background:#ffe0b2; padding:10px; border-radius:8px;">
      <label style="color:#d84315; margin-top:0;">Boîte absente : Transférée vers quelle chambre ?</label>
      <select id="bpeDestinationSelect" style="margin-top:5px;">
        <option value="">-- Choisir la chambre de destination --</option>
        ${optionsDestination}
      </select>
    </div>
  </div>

  <div class="card">
    <label style="margin-top:0; font-size:16px;">📷 Photos requises</label>
    <div class="photo-row" id="photoGrid">
      ${PHOTO_CATS.map(cat => `<div class="photo-wrapper" data-cat-wrapper="${cat.id}">${photoSlot(cat, c.photos[cat.id])}</div>`).join('')}
    </div>
  </div>
  
  <button id="validateBtn" class="btn ${c.done?'btn-secondary':'btn-success'}" style="margin-bottom:8px;">
    ${c.done?'↺ Rouvrir la chambre':'✓ Valider la chambre'}
  </button>
  <button id="nextBtn" class="btn" style="margin-bottom:8px;">Chambre suivante →</button>`;

  const updateVisibility = () => {
    const activeMasks = new Set();
    cont.querySelectorAll('input[data-field="masque_in"], input[data-field="masque_out"]').forEach(inp => {
      const val = inp.value.trim().toUpperCase();
      if(val) {
        const letter = val.charAt(0);
        if(['A','B','C','D'].includes(letter)) activeMasks.add(letter);
      }
    });

    const hasBoite = document.getElementById('boiteToggle').checked;

    document.querySelectorAll('[data-cat-wrapper]').forEach(wrapper => {
      const catId = wrapper.dataset.catWrapper;
      let visible = true;

      if(['MA','MB','MC','MD'].includes(catId)) {
        const letter = catId.charAt(1);
        if (activeMasks.size > 0) visible = activeMasks.has(letter);
      }

      if(['BOITE', 'ETIQ_BOITE'].includes(catId)) {
        visible = hasBoite;
      }

      wrapper.style.display = visible ? 'block' : 'none';
    });
  };

  cont.querySelectorAll('input[data-pass], select[data-pass]').forEach(inp=>{
    inp.oninput = (e) => {
      updateVisibility();
      const passId = inp.dataset.pass;
      const field = inp.dataset.field;
      const passage = c.passages.find(x => x.id === passId);
      if(passage) {
        passage[field] = e.target.value;
        dbPut(c);
      }
    };
  });

  document.getElementById('addPassageBtn').onclick = () => {
    c.passages.push({id: crypto.randomUUID(), masque_in:'', diam_in:'', masque_out:'', diam_out:'', cable_name:''});
    dbPut(c);
    openDetail(id);
  };

  cont.querySelectorAll('[data-del-passage]').forEach(btn => {
    btn.onclick = (e) => {
      e.preventDefault();
      if(confirm('Supprimer cette liaison ?')) {
        c.passages = c.passages.filter(x => x.id !== btn.dataset.delPassage);
        dbPut(c);
        openDetail(id);
      }
    };
  });

  document.getElementById('boiteToggle').onchange = (e) => {
    c.hasBoite = e.target.checked;
    document.getElementById('transfertBoiteDiv').style.display = c.hasBoite ? 'none' : 'block';
    dbPut(c);
    updateVisibility();
  };

  document.getElementById('bpeDestinationSelect').onchange = (e) => {
    c.bpeDestination = e.target.value;
    dbPut(c);
  };

  cont.querySelectorAll('input[type=file][data-cat]').forEach(inp=>{
    inp.onchange=async()=>{
      const files=Array.from(inp.files||[]);if(!files.length)return;
      const cat = inp.dataset.cat;
      showOverlay(true);
      try{
        for(const f of files){
          const blob=await compress(f);
          if(!c.photos[cat]) c.photos[cat] = [];
          c.photos[cat].push({id:crypto.randomUUID(),blob,ts:Date.now()});
        }
        await dbPut(c);openDetail(id);
      }catch(err){alert('Erreur photo : '+err.message);}
      finally{showOverlay(false);}
    };
  });

  cont.querySelectorAll('[data-del-cat]').forEach(b=>{
    b.onclick=async(e)=>{
      e.stopPropagation();e.preventDefault();
      const cat=b.dataset.delCat,label=b.dataset.catLabel;
      if(!confirm(`Supprimer toutes les photos « ${label} » ?`))return;
      c.photos[cat]=[];
      await dbPut(c);openDetail(id);
    };
  });

  document.getElementById('validateBtn').onclick=async()=>{c.done=!c.done;await dbPut(c);openDetail(id);};
  document.getElementById('nextBtn').onclick=()=>{
    const idx=chambres.findIndex(x=>x.id===id);const next=chambres[idx+1];
    if(next)openDetail(next.id);else{renderList();showScreen('list');}
  };

  updateVisibility();
  showScreen('detail');
}
function showOverlay(s){document.getElementById('overlay').classList.toggle('hidden',!s);}

async function importCSV(file){
  const text=await file.text();
  const rows=parseCSV(text);
  if(rows.length<2){alert('CSV invalide ou vide.');return;}
  headers=rows[0].map(h=>h.trim());
  const dataRows=rows.slice(1);
  
  const idIdx=(()=>{
    const pats=[/^CODE_CH1/i, /^id/i, /^ref/i, /chambre/i];
    for(const p of pats){const i=headers.findIndex(h=>p.test(h));if(i>=0)return i;}
    return 0;
  })();

  const mapChambres = new Map();
  
  for(const r of dataRows){
    const raw={};headers.forEach((h,i)=>raw[h]=(r[i]||'').trim());
    let id=raw[headers[idIdx]]||'CH-'+Math.random().toString(36).slice(2,8).toUpperCase();
    
    if(!mapChambres.has(id)) {
      mapChambres.set(id, {
        id, 
        raw, 
        done: false,
        hasBoite: true,
        bpeDestination: '',
        photos: PHOTO_CATS.reduce((acc, cat) => { acc[cat.id] = []; return acc; }, {}),
        passages: [{id: crypto.randomUUID(), masque_in:'', diam_in:'', masque_out:'', diam_out:'', cable_name:''}]
      });
    } else {
      const existing = mapChambres.get(id);
      existing.passages.push({id: crypto.randomUUID(), masque_in:'', diam_in:'', masque_out:'', diam_out:'', cable_name:''});
    }
  }
  
  const existingDb = new Map(chambres.map(c=>[c.id,c]));
  const newC = Array.from(mapChambres.values()).map(newCh => {
    if(existingDb.has(newCh.id)) {
      const oldCh = existingDb.get(newCh.id);
      oldCh.raw = newCh.raw;
      return oldCh;
    }
    return newCh;
  });

  await dbClear();chambres=newC;
  for(const c of chambres)await dbPut(c);
  updateHomeStats();
  alert(`${chambres.length} chambre(s) importée(s).`);
}

async function exportAll(){
  if(!chambres.length){alert('Rien à exporter.');return;}
  showOverlay(true);
  try{
    const zip=new JSZip();
    zip.file('releve_chambres.csv', '\uFEFF' + generateCSV());
    
    for(const c of chambres){
      const safe=c.id.replace(/[^A-Za-z0-9_-]/g,'_');
      
      PHOTO_CATS.forEach(catObj => {
        const catFolder = catObj.id;
        const photos = c.photos[catFolder] || [];
        
        photos.forEach((p, i) => {
          const n = String(i + 1).padStart(2, '0');
          zip.file(`photos/${safe}/${catFolder}/${catFolder}_${n}.jpg`, p.blob);
        });
      });
    }
    
    const blob = await zip.generateAsync({type:'blob',compression:'DEFLATE',compressionOptions:{level:6}});
    // On ajoute le nom JFC dans le nom du fichier ZIP
    const fname = 'JFC_Releve_' + new Date().toISOString().slice(0,19).replace(/[:T]/g,'-') + '.zip';
    
    const file = new File([blob], fname, { type: 'application/zip' });

    try {
      if (navigator.canShare && navigator.canShare({ files: [file] })) {
        await navigator.share({
          files: [file],
          title: 'Relevé Chambres JFC',
          text: 'Relevé terrain'
        });
      } else {
        throw new Error("Partage non supporté");
      }
    } catch (err) {
      console.warn("Partage natif échoué, téléchargement direct...", err);
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = fname;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 60000);
      alert("Le partage direct a été bloqué par le téléphone. Le fichier ZIP a été téléchargé dans vos dossiers, vous pouvez maintenant l'envoyer manuellement sur WhatsApp.");
    }
  }catch(e){alert('Erreur export : '+e.message);}
  finally{showOverlay(false);}
}

document.getElementById('csvInput').onchange=async e=>{
  const f=e.target.files[0];if(!f)return;showOverlay(true);
  try{await importCSV(f);}catch(err){alert('Erreur import : '+err.message);}
  finally{showOverlay(false);e.target.value='';}
};
document.getElementById('startBtn').onclick=()=>{renderList();showScreen('list');};
document.getElementById('exportBtn').onclick=exportAll;
document.getElementById('backBtn').onclick=()=>{
  if(!document.getElementById('screen-list').classList.contains('hidden')){updateHomeStats();showScreen('home');}
  else{renderList();showScreen('list');}
};
document.getElementById('resetBtn').onclick=async()=>{
  if(!confirm('Effacer TOUTES les données (chambres + photos) ?'))return;
  await dbClear();chambres=[];headers=[];updateHomeStats();alert('Données effacées.');
};

(async()=>{
  await openDB();chambres=await dbGetAll();updateHomeStats();
  if(chambres.length){renderList();showScreen('list');}
})();
</script>
</body>
</html>
